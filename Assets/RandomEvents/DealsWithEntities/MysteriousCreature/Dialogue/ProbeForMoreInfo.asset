  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6fa5db35ac5d81d49b0eff06f993ad07, type: 3}
  m_Name: ProbeForMoreInfo
  m_EditorClassIdentifier: 
  prompt:
  - promptText: '"Ah, a discerning traveler, seeking knowledge before accepting a
      gift. Your wisdom is evident. This item, though it may appear ordinary, possesses
      the power to shape your destiny."'
    action:
      m_PersistentCalls:
        m_Calls: []
  - promptText: '"It is not the item itself but how you wield it that determines
      its true value. Beware, for every boon carries a burden."'
    action:
      m_PersistentCalls:
        m_Calls: []
  - promptText: '"Will you embrace this uncertainty and let destiny weave its tapestry,
      or shall you walk away, leaving potential untapped?"'
    action:
      m_PersistentCalls:
        m_Calls: []
  promptResponses:
  - response: Accept the object
    responseAction:
      m_PersistentCalls:
        m_Calls: []
    nextPrompt: {fileID: 11400000, guid: 4129bada3752dbe4494b4092ed35d592, type: 2}
  - response: Refuse the object
    responseAction:
      m_PersistentCalls:
        m_Calls: []
    nextPrompt: {fileID: 11400000, guid: 5cf9fa8f84f807f4da5a00b5d619b018, type: 2}
  nextPrompt: {fileID: 0}
