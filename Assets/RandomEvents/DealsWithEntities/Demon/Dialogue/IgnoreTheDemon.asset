  m_Script: {fileID: 11500000, guid: 6fa5db35ac5d81d49b0eff06f993ad07, type: 3}
  m_Name: IgnoreTheDemon
  m_EditorClassIdentifier: 
  paragraphs:
  - paragraph: "As you begin walking away you hear behind you, \"Ah, leaving are
      you?\", its voice laced with mocking laughter. \"Do you really think you can
      simply walk away from me? Foolish mortal, the road ahead is fraught with dangers
      far greater than you can imagine. Without my aid, you\u2019ll be nothing but
      prey to the evils that lurk in the shadows.\""
    action:
      m_PersistentCalls:
        m_Calls: []
    audioDialogue:
      audioDialogueMixerGroups:
      - Time: 3.9158454
        MixerGroup: {fileID: 24300002, guid: 75eb9796b90238647ba4efa707e9793c, type: 2}
      - Time: 7.385146
        MixerGroup: {fileID: 0}
      - Time: 10.167457
        MixerGroup: {fileID: 24300002, guid: 75eb9796b90238647ba4efa707e9793c, type: 2}
      sectionalAudioClips:
      - audioClip: {fileID: 8300000, guid: e111745357a43af4b81e055fd8822156, type: 3}
        slider:
          MinLimit: 0
          MaxLimit: 1
          MinMaxValues: {x: 0, y: 0.98742145}
        time: 0
  - paragraph: "The demon's eyes narrow, and its grin widens menacingly. \"But go
      ahead, run if you must. Know that I will be watching, and when you find yourself
      in despair, you\u2019ll remember this moment. You\u2019ll wish you had taken
      my offer.\""
    action:
      m_PersistentCalls:
        m_Calls: []
    audioDialogue:
      audioDialogueMixerGroups:
      - Time: 6.2859616
        MixerGroup: {fileID: 24300002, guid: 75eb9796b90238647ba4efa707e9793c, type: 2}
      sectionalAudioClips:
      - audioClip: {fileID: 8300000, guid: 34121dd8c5ec018479388060b3c9a64f, type: 3}
        slider:
          MinLimit: 0
          MaxLimit: 1
          MinMaxValues: {x: 0, y: 0.9811321}
        time: 0
  - paragraph: As you continue to walk away, the demon's voice fades into an eerie
      whisper, leaving you with an unsettling feeling that you haven't seen the last
      of it.
    action:
      m_PersistentCalls:
        m_Calls: []
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips:
      - audioClip: {fileID: 8300000, guid: ee7a5db4dca4e2847b12416ca3b05f12, type: 3}
        slider:
