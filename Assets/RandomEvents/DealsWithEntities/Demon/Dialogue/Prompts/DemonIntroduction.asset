  m_Script: {fileID: 11500000, guid: 6fa5db35ac5d81d49b0eff06f993ad07, type: 3}
  m_Name: DemonIntroduction
  m_EditorClassIdentifier: 
  paragraphs:
  - paragraph: As you emerge from the forest clearing, you encounter a towering beast
      with goat horns, black fur, a long, whiplike tail, and imposing wings. It greets
      you with a wicked grin that reveals a row of ghastly teeth. Beside it sits
      a large bag brimming with gold and treasure.
    action:
      m_PersistentCalls:
        m_Calls: []
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips:
      - audioClip: {fileID: 8300000, guid: 4ecf1b43f889ced41940c8a3607b7de4, type: 3}
        slider:
          MinLimit: 0
          MaxLimit: 1
          MinMaxValues: {x: 0.01257864, y: 0.9811321}
        time: 0
  - paragraph: '"Ah, a mortal... how delightful," the creature says, its grin widening
      unnaturally. "You must be aware of the dangers that lie ahead. Why not sit
      with me and allow me to offer you something that might aid you on your journey?"'
    action:
      m_PersistentCalls:
        m_Calls: []
    audioDialogue:
      audioDialogueMixerGroups:
      - Time: 0
        MixerGroup: {fileID: 24300002, guid: 75eb9796b90238647ba4efa707e9793c, type: 2}
