  paragraphs:
  - paragraph: '"Wise choice, traveler; it will surely offer you protection," the
      wizard says while a faint smile plays at the corners of his mouth.'
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips: []
  - paragraph: Before you can respond, he utters an incantation and vanishes before
      your eyes.
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips: []
