          MinMaxValues: {x: 0.018867925, y: 0.9685535}
        time: 0
  - paragraph: It watches you intently, waiting for any sign of hesitation or reconsideration,
      ready to react based on your next move.
    action:
      m_PersistentCalls:
        m_Calls: []
