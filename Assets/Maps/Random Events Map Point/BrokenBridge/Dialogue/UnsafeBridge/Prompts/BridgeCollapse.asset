  m_Name: BridgeCollapse
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.Prompt
  paragraphs:
  - paragraph: Your risk is punished, the bridge collapses and you lose many pilgrims
      to the churning waters beneath.
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips: []
  - paragraph: The survivors are drained and devastated from the loss of their fellow
      travellers. And yet they must continue on this pilgrimage.
    audioDialogue:
      audioDialogueMixerGroups: []
      sectionalAudioClips: []
  promptResponses:
  - response: Continue on your journey
    nextPrompt: {fileID: 0}
    nextPromptSetupSettings: 0
